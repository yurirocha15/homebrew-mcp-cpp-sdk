        "visibility": "public",
        "default_branch": "main",
        "packages_public_after_first_upload": true,
        "secret_scanning": true,
        "push_protection": true,
        "retention_days": 90
    },
    "actions": {
        "default_workflow_permissions": "read",
        "can_approve_pull_requests": false,
        "github_hosted_runners_only": true,
        "require_full_sha": true,
        "allowed_actions": {
            "actions/checkout": "9c091bb21b7c1c1d1991bb908d89e4e9dddfe3e0",
            "actions/upload-artifact": "043fb46d1a93c77aae656e7c1c64a875d1fc6a0a",
            "actions/download-artifact": "3e5f45b2cfb9172054b4087a40e8e0b5a5461e7c",
            "actions/create-github-app-token": "bcd2ba49218906704ab6c1aa796996da409d3eb1",
            "actions/attest": "a1948c3f048ba23858d222213b7c278aabede763"
        },
        "allowed_workflows": {
            "ci.yml": [
                "push",
                "pull_request"
            ],
            "publish-bottles.yml": [
                "workflow_dispatch"
            ]
        }
    },
    "main_ruleset": {
        "enforcement": "active",
        "pull_request_required": true,
        "required_approvals": 0,
        "signed_commits": true,
        "linear_history": true,
        "conversation_resolution": true,
        "deletion_blocked": true,
        "force_push_blocked": true,
        "bypass_actors": [],
        "required_checks": [
            "tap-policy",
            "formula-style-audit",
            "trusted-bottle-policy"
        ]
    },
    "environments": [
        {
            "name": "homebrew-publish",
            "required_reviewer_count": 1,
            "prevent_self_review": false,
            "administrator_bypass": false,
            "deployment_branch": "main",
            "secrets": [
                "HOMEBREW_APP_PRIVATE_KEY"
            ],
            "variables": [
                "HOMEBREW_APP_CLIENT_ID"
            ]
        },
        {
            "name": "homebrew-finalize",
            "required_reviewer_count": 1,
            "prevent_self_review": false,
            "administrator_bypass": false,
            "deployment_branch": "main",
            "secrets": [
                "HOMEBREW_APP_PRIVATE_KEY"
            ],
            "variables": [
                "HOMEBREW_APP_CLIENT_ID"
            ]
        }
    ],
    "publisher_app_permissions": {
        "metadata": "read",
        "actions": "write",
        "contents": "write",
        "pull_requests": "write",
        "all_other_permissions": "none"
    },
    "repository_variables": [
        "SOURCE_REPOSITORY_ID",
        "SOURCE_OWNER_ID",
        "SOURCE_SIGNING_PRIMARY_FINGERPRINT",
        "SOURCE_TAG_SIGNING_SUBKEY_FINGERPRINT",
        "SOURCE_ARTIFACT_SIGNING_SUBKEY_FINGERPRINT"
    ],
    "workflow_constants": {
        "publisher_bot_login": "mcp-cpp-sdk-homebrew-publisher[bot]"
    },
    "trusted_workflow_contract": {
        "formula_branch": "release/mcp-cpp-sdk-vX.Y.Z",
        "formula_path": "Formula/mcp-cpp-sdk.rb",
        "same_original_run_required": true,
        "new_dispatch_cannot_finalize": true,
        "finalizer_rebuilds_or_reuploads": false,
        "anonymous_ghcr_digest_check_required": true
    }
