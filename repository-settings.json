{
    "schema_version": 1,
    "repository": {
        "full_name": "yurirocha15/homebrew-mcp-cpp-sdk",
        "visibility": "public",
        "default_branch": "main",
        "packages_public_after_first_upload": true,
        "secret_scanning": true,
        "push_protection": true,
        "retention_days": 90
    },
    "actions": {
        "default_workflow_permissions": "read",
        "can_approve_pull_requests": false,
        "github_hosted_runners_only": true,
        "require_full_sha": true,
        "allowed_actions": {
            "actions/checkout": "3d3c42e5aac5ba805825da76410c181273ba90b1",
            "actions/upload-artifact": "cf430e030ddbb5b0abf93d22962f4752f3646cd9",
            "actions/download-artifact": "9000827ccba6bdab643e8b6fd33ac0654aef8333",
            "actions/create-github-app-token": "64ab729a6294000f5aa4a4bc0b73d1f32bc45510"
        },
        "allowed_workflows": {
            "ci.yml": [
                "push",
                "pull_request"
            ],
            "publish-bottles.yml": [
                "workflow_dispatch"
            ]
        }
    },
    "main_ruleset": {
        "enforcement": "active",
        "pull_request_required": true,
        "required_approvals": 0,
        "signed_commits": true,
        "linear_history": true,
        "conversation_resolution": true,
        "deletion_blocked": true,
        "force_push_blocked": true,
        "bypass_actors": [],
        "required_checks": [
            "tap-policy",
            "formula-style-audit",
            "trusted-bottle-policy"
        ]
    },
    "control_tag_ruleset": {
        "tag": "release-control-v3",
        "enforcement": "active",
        "update_blocked": true,
        "deletion_blocked": true,
        "bypass_actors": []
    },
    "environments": [
        {
            "name": "homebrew-publish",
            "required_reviewer_count": 1,
            "prevent_self_review": false,
            "administrator_bypass": false,
            "deployment_ref": "refs/tags/release-control-v3",
            "secrets": [
                "HOMEBREW_APP_PRIVATE_KEY"
            ],
            "variables": [
                "HOMEBREW_APP_CLIENT_ID"
            ]
        },
        {
            "name": "homebrew-finalize",
            "required_reviewer_count": 1,
            "prevent_self_review": false,
            "administrator_bypass": false,
            "deployment_ref": "refs/tags/release-control-v3",
            "secrets": [
                "HOMEBREW_APP_PRIVATE_KEY"
            ],
            "variables": [
                "HOMEBREW_APP_CLIENT_ID"
            ]
        }
    ],
    "publisher_app_permissions": {
        "metadata": "read",
        "actions": "write",
        "contents": "write",
        "pull_requests": "write",
        "all_other_permissions": "none"
    },
    "repository_variables": [
        "SOURCE_REPOSITORY_ID",
        "SOURCE_OWNER_ID",
        "SOURCE_SIGNING_PRIMARY_FINGERPRINT",
        "SOURCE_TAG_SIGNING_SUBKEY_FINGERPRINT",
        "SOURCE_ARTIFACT_SIGNING_SUBKEY_FINGERPRINT"
    ],
    "trusted_workflow_contract": {
        "dispatch_fields": [
            "github_release_id",
            "provider_control_sha",
            "release_manifest_sha256",
            "request_uuid",
            "source_commit_sha",
            "source_tag",
            "source_workflow_head_sha",
            "source_workflow_run_id"
        ],
        "provider_control_ref": "refs/tags/release-control-v3",
        "formula_branch": "release/mcp-cpp-sdk-vX.Y.Z",
        "formula_path": "Formula/mcp-cpp-sdk.rb",
        "same_original_run_required": true,
        "finalizer_rebuilds_or_reuploads": false,
        "anonymous_ghcr_digest_check_required": true,
        "exact_existing_state_is_idempotent": true,
        "conflicting_existing_state_fails_closed": true
    }
}
